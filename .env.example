# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection string (docker compose service: db, published on host port 5433)
DATABASE_URL=postgres://vesta:vesta@localhost:5433/vesta

# HTTP port of the app
# Note: on Windows ports in Hyper-V reserved ranges (see
# `netsh interface ipv4 show excludedportrange protocol=tcp`) give EACCES —
# pick a port outside those ranges, e.g. 3300.
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=debug

# Environment: development | test | production
NODE_ENV=development

# Yandex Dialogs skill id (from the skill console). Optional: when set, the Alice
# webhook rejects requests with a different session.skill_id with 403.
# ALICE_SKILL_ID=

# VK community (group) integration. Optional: without these the VK poller stays
# disabled and the rest of the app works as usual. Both must be set together.
# Token: community page → Управление → Работа с API → Ключи доступа (право
# «Сообщения сообщества»). Group id: Управление → Дополнительная информация.
# VK_GROUP_TOKEN=
# VK_GROUP_ID=

# VK API base URL. Optional, defaults to https://api.vk.com.
# Override only for tests/stubs.
# VK_API_BASE_URL=https://api.vk.com

# Comma-separated peer ids allowed to use the bot. Optional: when set, messages
# from other dialogs are ignored (the community is publicly discoverable in VK).
# VK_ALLOWED_PEER_IDS=123456789,987654321
